# LDS Standard Works Contextual Retrieval - Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required)
# Used for: embeddings, chapter summary generation, LLM judge evaluation
OPENAI_API_KEY=sk-...

# Pinecone API Key (required)
# Used for: vector database operations
PINECONE_API_KEY=pcsk_...

# Cohere API Key (optional)
# Used for: reranking in retrieval pipeline
COHERE_API_KEY=

# Anthropic API Key (optional)
# Used for: reranker training data generation
ANTHROPIC_API_KEY=sk-ant-...
